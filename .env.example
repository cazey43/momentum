# ---------------------------------------------------------------------------
# Momentum — environment configuration
#
# Copy to `.env.local` and fill in. NEVER commit the filled-in file.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Branding ---------------------------------------------------------------
# The assistant's name. Changing this changes it everywhere in the UI.
NEXT_PUBLIC_APP_NAME=Momentum


# --- Database ---------------------------------------------------------------
# Local SQLite file. Contains personal mail excerpts and tasks — it is
# gitignored and should stay on this machine.
DATABASE_URL=file:./momentum.db


# --- Model provider ---------------------------------------------------------
# Required for real classification, summarization, and drafting.
# Without it the app falls back to the deterministic provider and says so in
# the UI rather than pretending to be smart.
ANTHROPIC_API_KEY=

# Model used for all reasoning. claude-opus-5 is the current default.
MOMENTUM_MODEL=claude-opus-5

# Reasoning depth: low | medium | high | xhigh | max
# `medium` is a deliberate default here: triage and extraction are high-volume
# and latency-sensitive. Raise to `high` if extraction quality disappoints.
MOMENTUM_MODEL_EFFORT=medium

# Set to `fake` to force the deterministic provider even when a key is present.
# The test suite always uses `fake` regardless of this value.
MOMENTUM_MODEL_PROVIDER=anthropic


# --- Encryption -------------------------------------------------------------
# 32-byte key, base64-encoded, used to encrypt OAuth tokens at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MOMENTUM_ENCRYPTION_KEY=

# Signs the local session cookie. Generate the same way as above.
MOMENTUM_SESSION_SECRET=


# --- Microsoft 365 / Outlook (optional) -------------------------------------
# Least-privilege, READ-ONLY scopes. Momentum never requests Mail.Send —
# approved drafts are sent through a separate, explicitly-granted scope that
# you opt into later in Settings.
#
# Register an app at https://entra.microsoft.com -> App registrations
#   Redirect URI (Web): http://localhost:3000/api/integrations/microsoft/callback
#   Delegated scopes:   offline_access User.Read Mail.Read MailboxSettings.Read
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT_ID=common
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REDIRECT_URI=http://localhost:3000/api/integrations/microsoft/callback


# --- Voice (optional) -------------------------------------------------------
# Hosted speech, read server-side and slotted in behind the speech ports.
# Leave these empty to use the browser's built-in Web Speech API (the default).
#
# Deepgram speech-to-text. Key from https://console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=

# ElevenLabs text-to-speech. Key from https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=

# The voice id (not the name) from https://elevenlabs.io -> Voices
ELEVENLABS_VOICE_ID=

# OPTIONAL — defaults to eleven_turbo_v2_5 when unset.
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5


# --- Behavior defaults ------------------------------------------------------
# All of these are editable in Settings; these are only the first-run values.
MOMENTUM_TIMEZONE=America/Detroit
MOMENTUM_BRIEFING_TIME=08:00
MOMENTUM_QUIET_HOURS_START=20:00
MOMENTUM_QUIET_HOURS_END=08:00
MOMENTUM_DAILY_NUDGE_BUDGET=2

# Start in demo mode with clearly-labeled sample data and no external calls.
MOMENTUM_DEMO_MODE=true
